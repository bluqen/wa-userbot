PORT=4000
PLUGIN_ENGINE_URL=http://localhost:8000

# Must match exactly what's registered as this instance's gatewayUrl (the
# GATEWAY_URL/shard URL on the web app side) -- used on startup to ask the
# web app which sessions belong to this instance so they can be
# reconnected automatically instead of staying dead until someone clicks
# "Reconnect" by hand.
PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=replace-with-a-long-random-string-matching-web/.env-and-plugins/.env

# Postgres connection string (e.g. from a free Neon project) -- stores
# WhatsApp session credentials so they survive the gateway process/disk
# being thrown away and restarted.
DATABASE_URL=postgresql://user:password@host/dbname

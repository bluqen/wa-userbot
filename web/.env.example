# Postgres connection string (e.g. from a free Neon project)
DATABASE_URL="postgresql://user:password@host/dbname"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
GATEWAY_URL="http://localhost:4000"
# Optional: comma-separated list of gateway instances to spread new
# sessions across (e.g. multiple free-tier hosts). Falls back to
# GATEWAY_URL above as the single shard if unset.
# GATEWAY_SHARD_URLS="http://localhost:4000,http://localhost:4001"
INTERNAL_API_SECRET="replace-with-a-long-random-string-matching-plugins/.env"
# Comma-separated allowlist of emails allowed to see /dashboard/admin/*
# (currently just gateway shard management). Redeploy required to change.
ADMIN_EMAILS="you@example.com"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  sessions     WaSession[]
}

model WaSession {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  phoneNumber String
  status      String          @default("connecting")
  // Which gateway instance actually holds this session's WhatsApp
  // connection. Assigned once at creation time (see lib/shards.ts) so we
  // can run more than one gateway instance -- e.g. to stay within a single
  // free-tier host's resource limits -- without a routing rewrite later.
  gatewayUrl  String          @default("http://localhost:4000")
  createdAt   DateTime        @default(now())
  plugins     SessionPlugin[]
  messages    ChatMessage[]
  scheduledTasks ScheduledTask[]
  stickers    Sticker[]
  notes       Note[]
  broadcastGroups BroadcastGroup[]
  leads       Lead[]

  @@index([userId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  sessionId  String
  session    WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactJid String
  role       String // 'user' | 'assistant'
  text       String
  createdAt  DateTime  @default(now())

  @@index([sessionId, contactJid, createdAt])
}

model SessionPlugin {
  id        String    @id @default(cuid())
  sessionId String
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key       String
  enabled   Boolean   @default(false)
  settings  String    @default("{}")
  updatedAt DateTime  @updatedAt

  @@unique([sessionId, key])
}

// Admin-managed pool of gateway instances new sessions get assigned to (see
// web/lib/shards.ts). Deliberately no relation to WaSession -- it's a pure
// lookup table read at session-creation time; WaSession.gatewayUrl stays a
// plain string copied at that moment, so removing/deactivating a shard here
// never touches existing sessions.
model GatewayShard {
  id        String   @id @default(cuid())
  url       String   @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // The plugin-engine instance this gateway is paired with. Purely
  // informational -- gateway reads its own PLUGIN_ENGINE_URL from its own
  // Render env var, not from this row, so nothing here changes runtime
  // behavior. Exists so the admin panel can show (and catch a mistake in)
  // the pairing when each shard is given its own dedicated plugin engine
  // instead of all shards sharing one, which made that one instance a
  // single point of overload no matter how many gateway shards existed.
  pluginEngineUrl String?
}

// Generic, reusable persisted scheduler. A row means "run this typed action
// for this session at/after runAt". `type` + `payload` (an untyped JSON
// string, same pattern as SessionPlugin.settings) is deliberately generic
// so a future feature reuses this table by picking a new `type` and
// registering a gateway-side handler for it (see gateway/src/scheduler.js)
// -- no schema change needed. The first user is temporary contact blocks
// (type "unblock_contact"). Cascades with its WaSession so deleting a
// session cleans up its pending tasks too.
model ScheduledTask {
  id          String    @id @default(cuid())
  sessionId   String
  session     WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String
  payload     String    @default("{}")
  runAt       DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([sessionId])
  @@index([runAt, completedAt])
}

// Stickers the account owner has taught the bot via WhatsApp itself
// (quote-reply to a sticker with "!savesticker <tag>" -- see
// gateway/README.md). Multiple stickers can share the same tag on purpose
// (e.g. several different "happy" stickers) -- saving one picks a random
// match at send time (see the internal stickers/[sessionId]/[tag] route),
// so re-using a tag adds variety instead of overwriting the previous
// capture. Stored directly in Postgres (Bytes/bytea) -- WhatsApp stickers
// are tiny .webp files, no object storage service needed at this scale.
model Sticker {
  id        String   @id @default(cuid())
  sessionId String
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tag       String
  data      Bytes
  mimetype  String   @default("image/webp")
  createdAt DateTime @default(now())

  @@index([sessionId, tag])
}

// Quick-recall snippets: the account owner reply-quotes any message (text
// or media -- image, video, voice note, sticker, document) with
// "!savenote <name>", then drops it into any conversation later with
// "#name" (see gateway/README.md). Unlike stickers, a note is meant to be
// one canonical named snippet -- re-saving a name overwrites it rather
// than adding a variant, so @@unique (not just an index) is right here.
model Note {
  id        String    @id @default(cuid())
  sessionId String
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  kind      String    // 'text' | 'media'
  text      String    @default("") // the note text itself, or a media note's caption
  data      Bytes?    // set only for kind = 'media'
  mimetype  String?
  mediaType String?   // Baileys message-type key (imageMessage/videoMessage/...), so it can be resent as the same kind of attachment
  fileName  String?
  createdAt DateTime  @default(now())

  @@unique([sessionId, name])
}

// Sales-lead signals (name/need/budget/timeline) the "leads" plugin
// quietly extracts from a conversation via an LLM call -- never shown to
// the customer, purely for the owner's own dashboard reference. Upserts
// by (sessionId, contactJid): the latest summary wins, since a running
// history of every extraction attempt isn't the point, just the current
// read on that contact.
model Lead {
  id         String    @id @default(cuid())
  sessionId  String
  session    WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactJid String
  summary    String
  updatedAt  DateTime  @updatedAt

  @@unique([sessionId, contactJid])
}

// A group the owner has tagged for broadcast use by sending
// "!addbroadcast <name>" *inside* that group (see gateway/README.md) --
// avoids ever needing to know/type a group's opaque JID by hand. Re-using
// a name re-tags whichever group it's sent in next, same overwrite
// semantics as Note above.
model BroadcastGroup {
  id        String    @id @default(cuid())
  sessionId String
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  jid       String
  groupName String    @default("")
  createdAt DateTime  @default(now())

  @@unique([sessionId, name])
}

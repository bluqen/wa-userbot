WEB_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=replace-with-a-long-random-string

# Free tier from https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional second free tier -- used as a fallback if Groq fails or its daily
# quota runs out. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional -- powers the "Song Fetcher" plugin (see app/plugins/song.py).
# Free client id, no credit card required: https://developer.jamendo.com
# Without this set, the plugin silently does nothing even if enabled.
JAMENDO_CLIENT_ID=

# Optional -- powers the "Pinterest" plugin (see app/plugins/pinterest.py).
# Pinterest itself has no public search API; this actually queries Pexels'
# free stock-photo search. Free instant-signup key, no credit card:
# https://www.pexels.com/api. Without this set, the plugin silently does
# nothing even if enabled.
PEXELS_API_KEY=
